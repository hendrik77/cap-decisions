{
  "name": "cap-jev",
  "version": "0.8.0",
  "description": "Internal System One decision service for SAP CAP",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cap-jev-mock": "dist/mock-server-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers/cloudflare": {
      "types": "./dist/providers/cloudflare.d.ts",
      "default": "./dist/providers/cloudflare.js"
    },
    "./providers/mock": {
      "types": "./dist/providers/mock.d.ts",
      "default": "./dist/providers/mock.js"
    },
    "./mock-server": {
      "types": "./dist/mock-server.d.ts",
      "default": "./dist/mock-server.js"
    },
    "./package.json": "./package.json",
    "./cds-plugin": "./cds-plugin.js",
    "./cds-plugin.js": "./cds-plugin.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hendrik77/cap-jev.git"
  },
  "keywords": [
    "sap",
    "cap",
    "system-one",
    "jev",
    "decision-service"
  ],
  "author": "Hendrik Neumann",
  "files": [
    "dist",
    "cds-plugin.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    ".",
    "examples/cap-app",
    "examples/provider-package"
  ],
  "peerDependencies": {
    "@sap/cds": ">=9",
    "@sap-cloud-sdk/connectivity": "^4.9.1"
  },
  "peerDependenciesMeta": {
    "@sap-cloud-sdk/connectivity": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-types": "^0.20.0",
    "@sap/cds": "^10.0.0",
    "@sap/cds-dk": "^10",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0"
  },
  "scripts": {
    "lint": "eslint .",
    "release:check": "node scripts/release-check.cjs",
    "format": "prettier --write src tests scripts examples/cap-app/srv",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json && tsc -p examples/cap-app/tsconfig.json",
    "build": "tsc && node -e \"require('fs').chmodSync('dist/mock-server-cli.js', 0o755)\"",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepack": "npm run build"
  },
  "cds": {
    "requires": {
      "systemone": {
        "kind": "systemone-generic",
        "[development]": {
          "kind": "systemone-mock"
        },
        "[test]": {
          "kind": "systemone-mock"
        }
      },
      "kinds": {
        "systemone-defaults": {
          "impl": "cap-jev",
          "timeoutMs": 10000
        },
        "systemone-generic": {
          "kind": "systemone-defaults"
        },
        "systemone-typesafe": {
          "kind": "systemone-defaults",
          "modelId": "jev-latest",
          "requiresToken": true,
          "limits": {
            "choiceOptions": 255,
            "scoreCriteria": {
              "min": 2,
              "max": 10
            }
          },
          "credentials": {
            "url": "https://api.typesafe.ai/v1/systemone"
          }
        },
        "systemone-cloudflare": {
          "kind": "systemone-defaults",
          "impl": "cap-jev/providers/cloudflare",
          "modelId": "clef",
          "requiresToken": true,
          "limits": {
            "questions": 64
          }
        },
        "systemone-mock": {
          "kind": "systemone-defaults",
          "impl": "cap-jev/providers/mock"
        },
        "systemone-laya": {
          "kind": "systemone-defaults",
          "limits": {
            "choiceOptions": 100
          },
          "credentials": {
            "url": "http://127.0.0.1:8000/v1/systemone"
          }
        }
      }
    }
  }
}
