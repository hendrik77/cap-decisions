{
  "name": "cap-decisions",
  "version": "0.10.0",
  "description": "CAP plugin for decision models (Jev, Laya, Clef, …). Community project, not affiliated with SAP or TypeSafe.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cap-decisions-mock": "dist/mock-server-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers/cloudflare": {
      "types": "./dist/providers/cloudflare.d.ts",
      "default": "./dist/providers/cloudflare.js"
    },
    "./providers/subq": {
      "types": "./dist/providers/subq.d.ts",
      "default": "./dist/providers/subq.js"
    },
    "./providers/mock": {
      "types": "./dist/providers/mock.d.ts",
      "default": "./dist/providers/mock.js"
    },
    "./mock-server": {
      "types": "./dist/mock-server.d.ts",
      "default": "./dist/mock-server.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json",
    "./cds-plugin": "./cds-plugin.js",
    "./cds-plugin.js": "./cds-plugin.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hendrik77/cap-decisions.git"
  },
  "keywords": [
    "sap",
    "cap",
    "decisions",
    "decision-model",
    "decision-service",
    "jev",
    "system-one"
  ],
  "author": "Hendrik Neumann",
  "files": [
    "dist",
    "cds-plugin.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    ".",
    "examples/cap-app",
    "examples/provider-package"
  ],
  "peerDependencies": {
    "@sap/cds": "^9 || ^10",
    "@sap-cloud-sdk/connectivity": "^4.9.1"
  },
  "peerDependenciesMeta": {
    "@sap-cloud-sdk/connectivity": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-types": "^0.20.0",
    "@sap/cds": "^10.0.0",
    "@sap/cds-dk": "^10",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0"
  },
  "scripts": {
    "lint": "eslint .",
    "release:check": "node scripts/release-check.cjs",
    "format": "prettier --write src tests scripts examples/cap-app/srv",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json && tsc -p examples/cap-app/tsconfig.json",
    "build": "tsc && node -e \"require('fs').chmodSync('dist/mock-server-cli.js', 0o755)\"",
    "test": "npm run build && node --test tests/*.test.cjs examples/provider-package/test/*.test.cjs",
    "coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include='dist/**' --test-coverage-lines=98 --test-coverage-branches=96 --test-coverage-functions=98 tests/*.test.cjs examples/provider-package/test/*.test.cjs",
    "prepack": "npm run build"
  },
  "cds": {
    "requires": {
      "decisions": {
        "kind": "decisions-generic",
        "[development]": {
          "kind": "decisions-mock"
        },
        "[test]": {
          "kind": "decisions-mock"
        }
      },
      "kinds": {
        "decisions-defaults": {
          "impl": "cap-decisions",
          "timeoutMs": 10000
        },
        "decisions-generic": {
          "kind": "decisions-defaults"
        },
        "decisions-typesafe": {
          "kind": "decisions-defaults",
          "modelId": "jev-latest",
          "requiresToken": true,
          "limits": {
            "choiceOptions": 255,
            "scoreCriteria": {
              "min": 2,
              "max": 10
            }
          },
          "credentials": {
            "url": "https://api.typesafe.ai/v1/systemone"
          }
        },
        "decisions-subq": {
          "kind": "decisions-defaults",
          "impl": "cap-decisions/providers/subq",
          "modelId": "subq-snap-preview",
          "requiresToken": true,
          "limits": {
            "questions": 16,
            "choiceOptions": 255,
            "scoreCriteria": {
              "min": 2,
              "max": 10
            }
          },
          "credentials": {
            "url": "https://api.subq.ai/v1/systemone"
          }
        },
        "decisions-cloudflare": {
          "kind": "decisions-defaults",
          "impl": "cap-decisions/providers/cloudflare",
          "modelId": "clef",
          "requiresToken": true,
          "limits": {
            "questions": 64
          }
        },
        "decisions-mock": {
          "kind": "decisions-defaults",
          "impl": "cap-decisions/providers/mock"
        },
        "decisions-laya": {
          "kind": "decisions-defaults",
          "limits": {
            "choiceOptions": 100
          },
          "credentials": {
            "url": "http://127.0.0.1:8000/v1/systemone"
          }
        }
      }
    }
  }
}
