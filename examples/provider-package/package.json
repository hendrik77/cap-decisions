{
  "name": "cap-decisions-provider-acme",
  "version": "0.0.0",
  "private": true,
  "description": "Example provider package for cap-decisions",
  "license": "MIT",
  "main": "srv/acme-service.js",
  "files": [
    "srv",
    "cds-plugin.js",
    "README.md"
  ],
  "peerDependencies": {
    "cap-decisions": ">=0.5.0",
    "@sap/cds": "^9 || ^10"
  },
  "cds": {
    "requires": {
      "kinds": {
        "decisions-acme": {
          "kind": "decisions-defaults",
          "impl": "cap-decisions-provider-acme",
          "requiresToken": true,
          "limits": {
            "choiceOptions": 20
          }
        }
      }
    }
  }
}
